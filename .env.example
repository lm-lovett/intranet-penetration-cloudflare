# Copy to .env and fill in real values:
#   cp .env.example .env

TZ=Asia/Shanghai

# EasyTier virtual network. All peers must use the same name and secret.
EASYTIER_NETWORK_NAME=office
EASYTIER_NETWORK_SECRET=change-me-to-a-long-random-secret

# Public hostname published by Cloudflare Tunnel (no scheme, no port).
# Clients connect with:  -p wss://et.example.com
EASYTIER_PUBLIC_HOST=et.example.com

# Hostname shown in `easytier-cli peer` for this center node.
EASYTIER_HOSTNAME=cf-center

# Cloudflare Tunnel token from Zero Trust → Networks → Tunnels → Configure.
# Public hostname service URL must be: http://127.0.0.1:11011
TUNNEL_TOKEN=
