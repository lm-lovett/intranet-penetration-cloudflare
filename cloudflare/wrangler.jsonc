{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "easytier-center",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-21",
	"compatibility_flags": ["nodejs_compat"],
	"migrations": [
		{
			"new_sqlite_classes": ["EasyTierServer"],
			"tag": "v1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "EasyTierServer",
				"name": "EASYTIER_SERVER"
			}
		]
	},
	"vars": {
		"EASYTIER_HOSTNAME": "cf-center",
		"MAX_FRAME_BYTES": "1048576"
	},
	"workers_dev": true,
	"routes": [
		{
			"pattern": "lm191549149.me",
			"custom_domain": true
		}
	],
	"placement": {
		"mode": "smart"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
